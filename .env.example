# Example environment variables only.
# Never put real passwords, tokens, API keys, or private keys in this file.

NODE_ENV=development
APP_TIMEZONE=Asia/Seoul

# Application
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (example only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Authentication (example only)
JWT_SECRET=CHANGE_ME

# Cloudflare (example only)
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME
